# CMake package for refimage's C API. Installed by install.sh as
# <prefix>/lib/cmake/refimage/refimageConfig.cmake. Provides:
#
#   refimage::refimage         the shared library (librefimage_c)
#   refimage::refimage_static  the static library, with its system dependencies
#
#   find_package(refimage 1.0 REQUIRED)
#   target_link_libraries(app PRIVATE refimage::refimage)

include(CMakeFindDependencyMacro)
find_dependency(Threads)

get_filename_component(_refimage_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if(NOT TARGET refimage::refimage)
  add_library(refimage::refimage SHARED IMPORTED)
  set_target_properties(refimage::refimage PROPERTIES
    IMPORTED_LOCATION "${_refimage_prefix}/lib/@SHARED@"
    IMPORTED_SONAME "@SONAME@"
    INTERFACE_INCLUDE_DIRECTORIES "${_refimage_prefix}/include")
endif()

if(NOT TARGET refimage::refimage_static)
  add_library(refimage::refimage_static STATIC IMPORTED)
  set(_refimage_libs Threads::Threads ${CMAKE_DL_LIBS})
  if(APPLE)
    list(APPEND _refimage_libs "-framework CoreFoundation")
  endif()
  if(UNIX AND NOT APPLE)
    list(APPEND _refimage_libs gcc_s util rt)
  endif()
  if(UNIX)
    list(APPEND _refimage_libs m)
  endif()
  if(WIN32)
    list(APPEND _refimage_libs kernel32 ntdll userenv ws2_32 dbghelp synchronization)
  endif()
  set_target_properties(refimage::refimage_static PROPERTIES
    IMPORTED_LOCATION "${_refimage_prefix}/lib/librefimage_c.a"
    INTERFACE_INCLUDE_DIRECTORIES "${_refimage_prefix}/include"
    INTERFACE_LINK_LIBRARIES "${_refimage_libs}")
  unset(_refimage_libs)
endif()

unset(_refimage_prefix)
